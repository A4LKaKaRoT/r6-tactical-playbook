{
  "name": "r6-tactical-playbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "R6 Tactical Playbook – statisches Taktik-Tool für 5er-Stacks (Rainbow Six Siege, Y11S3 Operation Split Fire)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/make-spa-fallback.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-data.mjs",
    "check:all": "npm run typecheck && npm run validate && npm run test && npm run build",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "tactics:build": "node scripts/build-tactics.mjs && node scripts/build-variants.mjs",
    "variants:build": "node scripts/build-variants.mjs"
  },
  "dependencies": {
    "r6operators": "^2.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
